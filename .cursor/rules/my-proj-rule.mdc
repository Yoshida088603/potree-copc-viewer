    - path: ".nojekyll"
      description: "GitHub Pages で Jekyll を無効化する空ファイル"
    - path: "index.html"
      description: "examples/copc.html をコピーし、CSS/JS への ../ パスを削除して配置"
    - path: "libs/"
      description: "Potree が依存する外部ライブラリ (jQuery, three.js, proj4.js など)"
    - path: "build/potree/"
      contents:
        - "potree.js"
        - "potree.css"
        - "resources/"
