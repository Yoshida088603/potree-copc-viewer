      description: "COPC/EPT データセット"
steps:
  - name: "Potree をローカルでビルド"
    commands:
      - "git clone https://github.com/potree/potree.git"
      - "cd potree"
      - "git tag -l '1.8.*'"
      - "git checkout tags/1.8.0"
      - "npm install"
      - "npm run build"
  - name: "GitHub Pages 用ディレクトリを準備"
    actions:
      - "リポジトリルートに .nojekyll を作成"
      - "libs/, build/potree/, workers/, pointclouds/ をルートに配置"
      - "examples/copc.html を index.html にコピーし、パスを修正"
  - name: "デプロイと動作確認"
    actions:
      - "GitHub Pages を main ブランチのルートで有効化"
      - "potree.js が 200 OK で読み込まれることを確認"
      - "最終目的の COPC ファイルが Potree で正しく表示されることを確認"
data_formats:
  - COPC
  - EPT
example_viewer_url: "https://viewer.copc.io/?copc=https://gsrt.digiarc.aist.go.jp/3ddb-pds/copc/104811.copc.laz"

